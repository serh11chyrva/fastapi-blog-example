# MongoDB Atlas. Set the connection string before starting the application.
# Example: mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Percent-encode reserved characters in the username and password.
MONGODB_URL=
MONGODB_DATABASE=blog

API_PORT=8080

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Application security. Replace all values before exposing the application.
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:8080

# Local S3-compatible Garage storage.
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
GARAGE_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
GARAGE_SECRET_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
AVATAR_BUCKET=blog-avatars
AVATAR_MAX_BYTES=5242880
ARTICLE_THUMBNAIL_MAX_BYTES=10485760
PUBLICATION_IMAGE_MAX_BYTES=5242880

# Idempotent demo-data seed password. Local development only.
DEMO_PASSWORD=DemoPassword123!
