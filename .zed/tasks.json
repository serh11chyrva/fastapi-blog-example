[
  {
    "label": "Run API docs (reload, no Docker)",
    "command": "uv",
    "args": [
      "run",
      "uvicorn",
      "src.backend.api.preview:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8000",
      "--reload",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "show_summary": true,
  },
  {
    "label": "Run application (Nginx)",
    "command": "docker",
    "args": ["compose", "up", "--build"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "show_summary": true,
  },
  {
    "label": "Run application (dev reload)",
    "command": "docker",
    "args": [
      "compose",
      "-f",
      "docker-compose.yml",
      "-f",
      "docker-compose.dev.yml",
      "up",
      "-d",
      "api",
      "frontend-dev",
      "link-preview-worker",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "show_summary": true,
  },
]
